#!/usr/bin/env bash
# Launcher CLI para el Centro de Control de Quickshell (SUPER + I)

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

SEARCH_DIRS=(
    "$QUICKSHELL_DIR"
    "$SCRIPT_DIR/.."
    "$HOME/Documentos/MrDemonc-SHELL"
    "$HOME/Documentos/github/MrDemonc-SHELL"
    "/usr/share/mrdemonc-shell"
)

TARGET_SCRIPT=""
for d in "${SEARCH_DIRS[@]}"; do
    if [ -n "$d" ] && [ -f "$d/scripts/toggle_control_center.sh" ]; then
        TARGET_SCRIPT="$d/scripts/toggle_control_center.sh"
        break
    fi
done

if [ -z "$TARGET_SCRIPT" ]; then
    STATE="${XDG_RUNTIME_DIR:-/tmp}/quickshell_control_center.toggle"
    TMP_STATE="/tmp/quickshell_control_center.toggle"
    if [ -n "$1" ]; then
        CMD="TAB:$1"
    else
        CMD="TOGGLE"
    fi
    echo "$CMD" > "$STATE" 2>/dev/null || echo "$CMD" > "$TMP_STATE" 2>/dev/null || true
    exit 0
fi

exec bash "$TARGET_SCRIPT" "$@"
