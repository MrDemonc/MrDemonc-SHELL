#!/usr/bin/env bash
# Launcher CLI para el buscador y lanzador de aplicaciones de Quickshell (SUPER + Espacio)

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

SEARCH_DIRS=(
    "$QUICKSHELL_DIR"
    "$SCRIPT_DIR/.."
    "$HOME/Documentos/MrDemonc-SHELL"
    "/usr/share/mrdemonc-shell"
)

TARGET_SCRIPT=""
for d in "${SEARCH_DIRS[@]}"; do
    if [ -n "$d" ] && [ -f "$d/scripts/toggle_apps.sh" ]; then
        TARGET_SCRIPT="$d/scripts/toggle_apps.sh"
        break
    fi
done

if [ -z "$TARGET_SCRIPT" ]; then
    echo "Error: No se encontró toggle_apps.sh" >&2
    exit 1
fi

exec bash "$TARGET_SCRIPT" "$@"
