#!/usr/bin/env bash
# Wrapper para shell-theme con soporte CLI (set, list, install, create, export, remove, info) y GUI

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"

SEARCH_DIRS=(
    "$QUICKSHELL_DIR"
    "$SCRIPT_DIR/.."
    "$HOME/Documentos/MrDemonc-SHELL"
    "/usr/share/mrdemonc-shell"
)

TARGET_DIR=""
for d in "${SEARCH_DIRS[@]}"; do
    if [ -n "$d" ] && [ -f "$d/scripts/theme_manager.py" ]; then
        TARGET_DIR="$d"
        break
    fi
done

if [ -z "$TARGET_DIR" ]; then
    echo "Error: No se encontró el directorio de MrDemonc-SHELL" >&2
    exit 1
fi

case "$1" in
    set|apply|list|install|create|export|remove|delete|info|help|-h|--help)
        exec python3 "$TARGET_DIR/scripts/theme_manager.py" "$@"
        ;;
    *)
        exec "$TARGET_DIR/scripts/toggle_theme_picker.sh" "$@"
        ;;
esac
