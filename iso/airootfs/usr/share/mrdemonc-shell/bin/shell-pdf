#!/usr/bin/env bash
# Launcher para el visor de PDFs Quickshell

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
SEARCH_DIRS=(
    "$SCRIPT_DIR/../viewers/shell-pdf"
    "$HOME/Documentos/MrDemonc-SHELL/viewers/shell-pdf"
    "/usr/share/mrdemonc-shell/viewers/shell-pdf"
)

TARGET_FILE=""
if [ -n "$1" ]; then
    TARGET_FILE="$(realpath "$1")"
fi

for dir in "${SEARCH_DIRS[@]}"; do
    if [ -f "$dir/shell.qml" ]; then
        TARGET_FILE="$TARGET_FILE" exec quickshell -p "$dir"
    fi
done

echo "Error: No se encontró el visor shell-pdf en Quickshell" >&2
exit 1
