#!/usr/bin/env bash
# ==============================================================================
#  MrDemonc-SHELL: Inicializador de Perfiles de Audio (PipeWire / ALSA)
# ==============================================================================
# Configura automáticamente el perfil de audio óptimo (altavoces + HDMI)
# para portátiles con chipsets Intel SOF / Alder Lake y monitor externo.

PROFILE="HiFi (HDMI1, HDMI2, HDMI3, Mic1, Mic2, Speaker)"
FALLBACK_CARD_NAME="alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic"

# 1. Aplicar a tarjetas enumeradas por pactl
for card in $(pactl list cards short 2>/dev/null | awk '{print $1}'); do
    pactl set-card-profile "$card" "$PROFILE" 2>/dev/null || true
done

# 2. Respaldo por nombre exacto de dispositivo si aún no estuviese aplicado
pactl set-card-profile "$FALLBACK_CARD_NAME" "$PROFILE" 2>/dev/null || true

# 3. Guardar estado predeterminado en WirePlumber para persistencia entre reinicios
if [ -n "$HOME" ]; then
    WP_DIR="$HOME/.local/state/wireplumber"
    mkdir -p "$WP_DIR"
    if [ ! -f "$WP_DIR/default-profile" ] || ! grep -q "$PROFILE" "$WP_DIR/default-profile" 2>/dev/null; then
        cat << EOF > "$WP_DIR/default-profile"
[default-profile]
$FALLBACK_CARD_NAME=$PROFILE
EOF
    fi
fi
