#!/usr/bin/env bash
# Launcher para el reproductor de video Quickshell

REAL_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
SEARCH_DIRS=(
    "$SCRIPT_DIR/../viewers/shell-video"
    "$HOME/Documentos/github/MrDemonc-SHELL/viewers/shell-video"
    "$HOME/Documentos/MrDemonc-SHELL/viewers/shell-video"
    "/usr/share/mrdemonc-shell/viewers/shell-video"
)

TARGET_FILE=""
if [ -n "$1" ]; then
    ARG="$1"
    if [[ "$ARG" =~ ^file:// ]]; then
        ARG="${ARG#file://}"
        ARG="$(python3 -c "import urllib.parse, sys; print(urllib.parse.unquote(sys.argv[1]))" "$ARG" 2>/dev/null || echo "$ARG")"
    fi
    if [ -e "$ARG" ]; then
        TARGET_FILE="$(realpath "$ARG" 2>/dev/null || echo "$ARG")"
    else
        TARGET_FILE="$ARG"
    fi
fi

for dir in "${SEARCH_DIRS[@]}"; do
    if [ -f "$dir/shell.qml" ]; then
        TARGET_FILE="$TARGET_FILE" exec quickshell -p "$dir"
    fi
done

echo "Error: No se encontró el reproductor shell-video en Quickshell" >&2
exit 1
