[Desktop Entry]
Name=Reproductor de Video
Comment=Reproductor de video minimalista con controles flotantes
Exec=shell-video %F
Icon=video-player
Terminal=false
Type=Application
Categories=AudioVideo;Video;Player;
MimeType=video/mp4;video/webm;video/x-matroska;video/quicktime;video/x-msvideo;video/ogg;video/mpeg;video/avi;
StartupNotify=true
StartupWMClass=shell-video
