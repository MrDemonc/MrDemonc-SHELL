[Desktop Entry]
Name=Visor de Imágenes
Comment=Visor de imágenes minimalista con soporte de temas
Exec=shell-image %F
Icon=image-viewer
Terminal=false
Type=Application
Categories=Graphics;Viewer;
MimeType=image/bmp;image/gif;image/jpeg;image/jpg;image/pjpeg;image/png;image/tiff;image/webp;image/x-bmp;image/x-portable-anymap;image/x-portable-bitmap;image/x-portable-graymap;image/x-portable-pixmap;image/x-xbitmap;image/x-xpixmap;image/svg+xml;image/avif;
StartupNotify=true
StartupWMClass=shell-image
