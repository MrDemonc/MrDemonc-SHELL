{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/pato.gif",
        "type": "kitty-icat",
        "width": 20,
        "height": 10,
        "padding": {
            "top": 1,
            "left": 1,
            "right": 3
        }
    },
    "display": {
        "separator": "  "
    },
    "modules": [
        {
            "type": "custom",
            "format": "{#38;2;122;162;247}╭────────────╮{#}"
        },
        {
            "type": "title",
            "key": "{#38;2;122;162;247}│{#} {#38;2;125;207;255} user     {#38;2;122;162;247}│{#}",
            "format": "{user-name} {#90}@{#} {host-name}"
        },
        {
            "type": "os",
            "key": "{#38;2;122;162;247}│{#} {#38;2;125;207;255}󰌽 distro   {#38;2;122;162;247}│{#}"
        },
        {
            "type": "kernel",
            "key": "{#38;2;122;162;247}│{#} {#38;2;125;207;255} kernel   {#38;2;122;162;247}│{#}"
        },
        {
            "type": "wm",
            "key": "{#38;2;122;162;247}│{#} {#38;2;187;154;247} desktop  {#38;2;122;162;247}│{#}"
        },
        {
            "type": "terminal",
            "key": "{#38;2;122;162;247}│{#} {#38;2;187;154;247} term     {#38;2;122;162;247}│{#}"
        },
        {
            "type": "shell",
            "key": "{#38;2;122;162;247}│{#} {#38;2;187;154;247} shell    {#38;2;122;162;247}│{#}"
        },
        {
            "type": "uptime",
            "key": "{#38;2;122;162;247}│{#} {#38;2;224;175;104}󰅐 uptime   {#38;2;122;162;247}│{#}"
        },
        {
            "type": "packages",
            "key": "{#38;2;122;162;247}│{#} {#38;2;224;175;104}󰏖 pkgs     {#38;2;122;162;247}│{#}"
        },
        {
            "type": "cpu",
            "key": "{#38;2;122;162;247}│{#} {#38;2;247;118;142}󰍛 cpu      {#38;2;122;162;247}│{#}",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "{#38;2;122;162;247}│{#} {#38;2;247;118;142}󰢮 gpu      {#38;2;122;162;247}│{#}"
        },
        {
            "type": "memory",
            "key": "{#38;2;122;162;247}│{#} {#38;2;158;206;106}󰘚 memory   {#38;2;122;162;247}│{#}"
        },
        {
            "type": "disk",
            "key": "{#38;2;122;162;247}│{#} {#38;2;158;206;106}󰋊 disk     {#38;2;122;162;247}│{#}",
            "folders": "/",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "custom",
            "format": "{#38;2;122;162;247}├────────────┤{#}"
        },
        {
            "type": "colors",
            "key": "{#38;2;122;162;247}│{#} {#38;2;187;154;247}󰏘 colors   {#38;2;122;162;247}│{#}",
            "symbol": "circle"
        },
        {
            "type": "custom",
            "format": "{#38;2;122;162;247}╰────────────╯{#}"
        }
    ]
}