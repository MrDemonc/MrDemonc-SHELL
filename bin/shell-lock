#!/usr/bin/env bash
# ==============================================================================
#  MrDemonc-SHELL: Bloqueador de pantalla nativo con Quickshell (SUPER + L)
# ==============================================================================

RUNTIME_DIR="${XDG_RUNTIME_DIR:-/tmp}"
LOCK_FILE="${RUNTIME_DIR}/quickshell_lock.toggle"
LOCK_FIFO="${RUNTIME_DIR}/quickshell_lock.fifo"
ACTIVE_FILE="${RUNTIME_DIR}/quickshell_lock.active"

if [ "${1:-}" = "unlock" ]; then
    echo "El desbloqueo requiere autenticación en la pantalla de bloqueo." >&2
    exit 1
fi

# Si ya está bloqueado y quickshell está activo, salir de inmediato
if [ -f "$ACTIVE_FILE" ] && pgrep -f "quickshell" >/dev/null 2>&1; then
    exit 0
fi

# Si Hyprland tiene la sesión bloqueada huérfana (lockscreen colgada previa), limpiarla
if hyprctl -j monitors 2>/dev/null | grep -q '"LOCK"'; then
    hyprctl --instance 0 eval 'hl.clear_crashed_lockscreen()' >/dev/null 2>&1 || true
fi

# Asegurar que el supervisor / quickshell esté en ejecución
if ! pgrep -f "quickshell" >/dev/null 2>&1; then
    rm -f "$ACTIVE_FILE" 2>/dev/null || true
    if command -v shell-supervisor >/dev/null 2>&1; then
        shell-supervisor &
    elif [ -f "$HOME/Documentos/github/MrDemonc-SHELL/bin/shell-supervisor" ]; then
        "$HOME/Documentos/github/MrDemonc-SHELL/bin/shell-supervisor" &
    elif [ -f "$HOME/Documentos/github/MrDemonc-SHELL/shell.qml" ]; then
        quickshell -d -p "$HOME/Documentos/github/MrDemonc-SHELL" &
    elif [ -f "/usr/share/mrdemonc-shell/shell.qml" ]; then
        quickshell -p /usr/share/mrdemonc-shell &
    else
        quickshell &
    fi
    sleep 0.35
fi

# Notificar bloqueo inmediato a Quickshell (FIFO primero para latencia <1ms, respaldo archivo toggle)
if ! { [ -p "$LOCK_FIFO" ] && timeout 0.3 bash -c 'printf "LOCK\n" > "$1"' _ "$LOCK_FIFO"; }; then
    printf 'LOCK\n' > "$LOCK_FILE"
fi

# Confirmación del compositor (WlSessionLock.secure), hasta 3 segundos.
for i in {1..150}; do
    if [ -f "$ACTIVE_FILE" ]; then
        exit 0
    fi
    sleep 0.02
done

echo "No se pudo confirmar el bloqueo de la sesión." >&2
exit 1
